# The settings docker compose needs that must not be committed. Copy this
# file to .env in this folder (cp .env.example .env) and replace both values;
# .env is ignored by Git.
#
# Compose reads .env by itself, from the folder you run it in, and uses it only
# to fill in the ${...} references in docker-compose.yml. Containers see a
# value only where the compose file passes it on. Everything that is the same
# on every machine (the profile, the database URL, the allowed origin) is
# written in docker-compose.yml itself.

# The database password. Used twice: Postgres sets it on the opsdesk user when
# it creates the database, and the backend connects with it.
# Postgres reads it ONLY on the very first start, when the data volume is
# empty. Changing it here afterwards makes the backend's login fail, because
# the database still has the old one: either change it inside the database
# too (ALTER USER opsdesk PASSWORD '...'), or start over with
# `docker compose down -v`, which DELETES all the data.
DB_PASSWORD=replace-me-with-a-database-password

# Signs every login token: anyone who has it can sign in as anyone. At least
# 32 bytes, random. Generate one with:
#   openssl rand -base64 48
# This placeholder is deliberately too short, so an unedited copy of this file
# stops the backend at startup instead of running with a published key.
JWT_SECRET=CHANGE-ME
